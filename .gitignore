# This .gitignore file should be placed at the root of the Unity project.
# Based on https://github.com/github/gitignore/blob/main/Unity.gitignore

.utmp/

# Unity generated folders
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# Local WebGL build output convention: /Builds/WebGL/

*.log

# Blender backup files are not Unity source assets.
*.blend1
*.blend1.meta

# Memory captures and recordings can be large or contain sensitive data.
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Uncomment if Asset Store Tools should remain local.
# /[Aa]ssets/AssetStoreTools*

# Autogenerated JetBrains Rider plugin and personal settings
/[Aa]ssets/Plugins/Editor/JetBrains*
*.DotSettings.user

# IDE/editor caches and personal settings
.vs/
.vscode/
.idea/
.gradle/
ExportedObj/
.consulo/
*.swp
*.swo

# Autogenerated IDE solution and project files
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity generated meta files for generated IDE files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity and Mono crash output
sysinfo.txt
mono_crash.*

# Platform build packages
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# Test Runner generated files
InitTestScene*.unity*
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Addressables generated files
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting generated files
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Unity generated cache inside Assets
/[Aa]ssets/[Ss]ceneDependencyCache*

# OS files
.DS_Store
Thumbs.db
desktop.ini
desktop.ini.meta

# Personal Codex files
/AGENTS.md
/.codex/
