  overheadAnchor: {fileID: 8748059627552796026}
  firstDialogue:
  - "\uAC11\uC790\uAE30 \uC774\uB807\uAC8C \uD070 \uC2F1\uD06C\uD640\uC774 \uC0DD\uAE30\uB2E4\uB2C8..."
  - "\uB4E3\uC790\uD558\uB2C8 \uC790\uB124\uAC00 \uD22C\uC785\uB41C\uB2E4\uB354\uAD70,
    \uACE0\uC0DD\uC774 \uB9CE\uC544."
  - "\uC544\uB798\uB85C \uB0B4\uB824\uAC08\uC218\uB85D \uC911\uB825 \uC774\uC0C1
    \uD604\uC0C1\uC740 \uB354 \uAC15\uD574\uC9C8 \uAC70\uC57C. \n\uBC1C\uBC11\uACFC
    \uCC9C\uC7A5\uC744 \uB458 \uB2E4 \uC758\uC2EC\uD574."
  - "\uD558\uC9C0\uB9CC \uC6D0\uC778\uC740 \uCD5C\uD558\uBD80\uC5D0 \uBC18\uB4DC\uC2DC
    \uC788\uC5B4. \uADF8\uACF3\uAE4C\uC9C0 \uB3C4\uB2EC\uD574\uC11C \uADFC\uC6D0\uC744
    \uD655\uC778\uD574\uC918."
  repeatDialogue:
  - "\uC5B4\uC11C \uAC00\uBD10. \uCD5C\uD558\uBD80\uC5D0 \uB2F5\uC774 \uC788\uC744
    \uAC70\uC57C."
